# ── 服务 ───────────────────────────────────────────────
PORT=5173
# 只给自己电脑用就保持 127.0.0.1；想让手机在同一个 Wi-Fi 下打开，改成 0.0.0.0
HOST=127.0.0.1
# 上线到 https 时改成 1，Cookie 会带上 Secure
COOKIE_SECURE=0
# 留空则首次启动自动生成并保存到 data/session-secret
AUTH_SECRET=

# ── 两个账号（只有这两个人能进来）─────────────────────
USER1_ID=superneko111
USER1_NAME=小猫
USER1_PASS=miaomiaomiao@lxj
USER2_ID=handsomejinmao
USER2_NAME=金毛
USER2_PASS=AaA@neko

# ── Cloudflare R2（S3 兼容 API）────────────────────────
# 不填也能启动：照片会自动退回本机存储（data/uploads）。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2 用 auto 就行
R2_REGION=auto
# 可选：桶绑定的公开域名（如 https://img.example.com）。留空则每次读取都签发临时 GET 链接。
# 想用 R2 以外的 S3 兼容服务（阿里云 OSS / 腾讯 COS / Backblaze B2 / 自建 MinIO）：
#   S3_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
#   S3_PATH_STYLE=0        # R2 用 1（桶名在路径里），其余大多用 0（桶名在域名里）
S3_ENDPOINT=
S3_PATH_STYLE=1
R2_PUBLIC_BASE=
